# --- Gateway -----------------------------------------------------------
GITHUB_TOKEN=               # fine-grained PAT scoped to the two demo repos
GITHUB_OWNER=               # the GitHub org/user that owns storefront and payments-api
SESSION_SIGNING_KEY=        # shared HS256 secret between the gateway and the Streamlit app
ADMIN_TOKEN=                # bearer token for /admin/* routes
AUDIT_DB_PATH=data/audit.db
PORT=8080

# Per-agent bearer secrets. The gateway stores only their hash (see
# gateway/core/auth.py:AgentTokenStore.from_env).
AGENT_TOKEN_TRIAGE_AGENT=
AGENT_TOKEN_REVIEW_AGENT=

# --- Agents --------------------------------------------------------------
OPENAI_API_KEY=

# --- Streamlit app -------------------------------------------------------
GATEWAY_URL=http://localhost:8080
